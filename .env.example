# ANTHROPIC_API_KEY: Required for Claude AI news scraping, web search, and fact-checking.
# Configure this in AI Studio Settings > Secrets or in your hosting environment variables.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
